{
  "name": "poppin-social-extension",
  "version": "1.0.359",
  "displayName": "Poppin: Trade directly on X, Reddit or any page you read",
  "author": "Poppin Inc.",
  "description": "See a ticker in a post and buy it right there. On X, Reddit and any page you read, from your own wallet, in one tap.",
  "type": "module",
  "scripts": {
    "build": "vite build --mode arc && vite build -c vite.bridge.config.ts",
    "staging": "vite build --mode staging",
    "staging:watch": "vite build --watch --mode staging --minify false",
    "dev:watch": "vite build --watch  --mode development",
    "production:watch": "vite build --watch --mode production",
    "development:watch": "vite build --watch --mode development --minify false",
    "watch": "vite build --watch --mode development --minify false",
    "dev": "vite",
    "serve:firefox": "web-ext run --start-url \"about:debugging#/runtime/this-firefox\"  --source-dir ./dist/",
    "serve:chrome": "web-ext run -t chromium --start-url \"https://example.com\" --source-dir ./dist/",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:tickers": "node scripts/build-ticker-map.mjs",
    "build:store": "vite build && vite build -c vite.bridge.config.ts"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@preact/preset-vite": "^2.7.0",
    "@types/chrome": "^0.0.254",
    "@types/lodash": "^4.17.15",
    "@types/node": "^22.10.10",
    "@types/react-dom": "^19.0.3",
    "@types/react-resizable": "^3.0.8",
    "@types/sanitize-html": "^2.13.0",
    "@types/webextension-polyfill": "^0.10.6",
    "@ugurkellecioglu/vite-plugin-web-extension": "^5.1.3",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.20.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "jsdom": "^30.0.1",
    "rollup-plugin-modify": "^3.0.0",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.23.0",
    "vite": "^5.0.0",
    "vite-plugin-preload": "^0.4.2",
    "vite-plugin-svgr": "^4.3.0",
    "vitest": "^4.1.10",
    "web-ext": "^7.8.0"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@hookform/resolvers": "^3.10.0",
    "@mozilla/readability": "^0.6.0",
    "@mui/icons-material": "^6.3.1",
    "@mui/material": "^6.4.0",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@solana/web3.js": "^1.98.4",
    "@swype-org/deposit": "^0.3.31",
    "@tanstack/react-query": "^5.63.0",
    "@tanstack/react-query-devtools": "^5.63.0",
    "arctic": "^3.3.0",
    "axios": "^1.7.9",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.13",
    "emoji-picker-react": "^4.12.0",
    "fast-average-color": "^9.4.0",
    "firebase": "^11.1.0",
    "framer-motion": "^11.17.0",
    "input-otp": "^1.4.2",
    "jwt-decode": "^4.0.0",
    "linkedom": "^0.18.12",
    "lucide-react": "^0.523.0",
    "mui-one-time-password-input": "^5.0.0",
    "nanoid": "^5.0.9",
    "preact": "^10.19.2",
    "psl": "^1.15.0",
    "qrcode-generator": "^1.4.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-draggable": "^4.4.6",
    "react-hook-form": "^7.54.2",
    "react-infinite-scroll-component": "^6.1.0",
    "react-refresh": "^0.16.0",
    "react-resizable": "^3.0.5",
    "react-router": "^7.7.1",
    "react-select": "^5.10.0",
    "sanitize-html": "^2.14.0",
    "socket.io-client": "^4.8.1",
    "stream-chat": "^8.55.0",
    "tailwind-merge": "^3.3.0",
    "usehooks-ts": "^3.1.0",
    "webextension-polyfill": "^0.10.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.3"
  }
}
