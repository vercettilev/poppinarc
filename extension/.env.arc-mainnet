# ─────────────────────────────────────────────────────────────────────────
# extension-new, ARC EDITION on ARC MAINNET (vite build --mode arc-mainnet).
# Copied from .env.production; only the backend and the edition flag differ.
#
# vite.config.ts injects EVERY key in this file into the bundle via
# `define: { "process.env": {...} }`. Anything written here ships readable
# inside dist/. Never put a secret in this file.
#
# House rule: a var earns its line only if something in extension-new/src or
# vite.config.ts actually reads it. Verified 2026-09-04; the vars that lost
# their reader are listed at the bottom instead of being silently dropped.
# ─────────────────────────────────────────────────────────────────────────

MANIFEST_VERSION=3

# Gates the invite-code path in welcome/components/steps/SignInStep.tsx.
NEXT_PUBLIC_INVITE_ONLY=false

# ── Endpoints ────────────────────────────────────────────────────────────
NEXT_PUBLIC_WEB_URL=https://app.poppin.so
NEXT_PUBLIC_BACKEND_URL=https://arc-api-mainnet-production.up.railway.app
NEXT_PUBLIC_API_URL=https://arc-api-mainnet-production.up.railway.app/api/v1
NEXT_PUBLIC_BASE_URL=https://app.poppin.so

# Read by @repo/common (packages/common). extension-new does not bundle that
# package today — kept so the flag is already correct if it comes back.
NEXT_PUBLIC_IS_EXTENSION=true

# ── Firebase web SDK ─────────────────────────────────────────────────────
NEXT_PUBLIC_FIRESTORE_API_KEY=AIzaSyDBMvjtBcMD2BU2bbYvIv3QW1sl22LxuNw
NEXT_PUBLIC_FIRESTORE_AUTH_DOMAIN=commentin-6a05a.firebaseapp.com
NEXT_PUBLIC_FIRESTORE_PROJECT_ID=commentin-6a05a
NEXT_PUBLIC_FIRESTORE_STORAGE_BUCKET=commentin-6a05a.appspot.com
NEXT_PUBLIC_FIRESTORE_MESSEGING_SENDER_FILE=498264914410
NEXT_PUBLIC_FIRESTORE_APP_ID=1:498264914410:web:d45c980dca31136d661a93
NEXT_PUBLIC_FIRESTORE_DATABASE_URL=https://commentin-6a05a-default-rtdb.europe-west1.firebasedatabase.app

# ── Manifest (build-time only) ───────────────────────────────────────────
# REQUIRED. vite.config.ts does `.split(",")` behind a non-null assert for
# both externally_connectable and optional_host_permissions — a missing value
# breaks the build outright rather than degrading.
NEXT_PUBLIC_HOST_PERMISSIONS="https://*.poppin.so/*"

# ── Product flags (src/config/*.ts) ──────────────────────────────────────
# Onboarding V2: one install screen, sign-in and top-up deferred to the
# moment of intent. false → the original six-step welcome flow, byte-for-byte.
NEXT_PUBLIC_ONBOARDING_V2=true

# ditto (diamond) + streak (fire) badges on post headers. FLYWHEEL RESERVE:
# the code is intact, the surface is off until trading goes public.
NEXT_PUBLIC_FEED_GAMIFICATION=false

# ── Dropped 2026-09-04 — no reader left in extension-new ─────────────────
# NEXT_PUBLIC_ARC_FACTORY_ADDRESS
#     Fed ARC_ADDRESSES.*.poppinMarketFactory, which nothing imports since
#     the prediction removal. The address itself is preserved in git under
#     the archive/prediction-2026-08 tag.
# NEXT_PUBLIC_FEATURE_ARC_MICRO_MARKETS / _UNIFIED_BALANCE / _FORECAST_AGENT
# NEXT_PUBLIC_FEATURE_ARC_CROSS_VENUE_SETTLEMENT / _EURC_MARKETS / _X402_API
#     Same removal. src/config/arcChain.ts still exports these constants but
#     no component reads them any more.
# NEXT_PUBLIC_DEFAULT_PREDICTION_MODE / NEXT_PUBLIC_PREDICTION_MODES_ENABLED
#     The prediction-mode switchboard left arcChain.ts with the stack.
# NEXT_PUBLIC_GOOGLE_EXTENSION_CLIENT_ID
#     The manifest `oauth2` block retired with chrome.identity (see the note
#     in vite.config.ts); sign-in is a web redirect in every browser now.
# VITE_UMAMI_WEBSITE_ID / VITE_UMAMI_API_ENDPOINT
#     No reader in extension-new, packages/*, or poppin-web.

# ── Arc edition ──────────────────────────────────────────────────────────
# The arc-api-mainnet service on Railway (project poppin-arc, branch mainnet). For a local API, put
# the two URLs in .env.arc.local (gitignored). Sign-in at app.poppin.so is
# the same as the store build.
NEXT_PUBLIC_ARC_EDITION=true

# Arc mainnet (chain 5042): token addresses and the explorer (src/arc/chain.ts).
NEXT_PUBLIC_ARC_NETWORK=mainnet
