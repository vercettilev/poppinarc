# ─────────────────────────────────────────────────────────────────────────
# extension-new — env template. Copy to .env.development (local) or use
# .env.production (shipped build).
#
# vite.config.ts injects every key here into the bundle, so treat this file
# as public: no secrets, ever.
#
# The list below is the complete set of vars extension-new/src and
# vite.config.ts actually read (verified 2026-09-04). If you add a var here,
# add its reader too — otherwise it is just bytes in the shipped dist.
# ─────────────────────────────────────────────────────────────────────────

MANIFEST_VERSION=3

# Invite-gated sign-up (welcome/components/steps/SignInStep.tsx).
NEXT_PUBLIC_INVITE_ONLY=false

# ── Endpoints ────────────────────────────────────────────────────────────
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_BACKEND_URL=http://localhost:4545
NEXT_PUBLIC_API_URL=http://localhost:4545/api/v1
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# Read by @repo/common; extension-new does not bundle it today.
NEXT_PUBLIC_IS_EXTENSION=true

# ── Firebase web SDK ─────────────────────────────────────────────────────
NEXT_PUBLIC_FIRESTORE_API_KEY=
NEXT_PUBLIC_FIRESTORE_AUTH_DOMAIN=
NEXT_PUBLIC_FIRESTORE_PROJECT_ID=
NEXT_PUBLIC_FIRESTORE_STORAGE_BUCKET=
NEXT_PUBLIC_FIRESTORE_MESSEGING_SENDER_FILE=
NEXT_PUBLIC_FIRESTORE_APP_ID=
NEXT_PUBLIC_FIRESTORE_DATABASE_URL=

# ── Manifest (build-time only) ───────────────────────────────────────────
# REQUIRED. Comma-separated match patterns; vite.config.ts splits this behind
# a non-null assert for externally_connectable + optional_host_permissions.
# Leaving it empty fails the build.
NEXT_PUBLIC_HOST_PERMISSIONS="http://localhost:3000/*"

# ── Product flags (src/config/*.ts — each is the revert switch) ──────────
# Onboarding V2 (default true). false restores the six-step welcome flow.
NEXT_PUBLIC_ONBOARDING_V2=true
# ditto + streak badges on post headers (default false, FLYWHEEL RESERVE).
NEXT_PUBLIC_FEED_GAMIFICATION=false

# ── Arc — the custodial WALLET chain, not prediction ─────────────────────
# Prediction markets were removed 2026-08-12 (tag archive/prediction-2026-08)
# and the removal deleted the Arc backend too: apps/backend has no
# @Controller('arc/markets') and no @Controller('bridge'). The extension's
# ArcService / BridgeService still point at those routes, so turning either
# flag on produces 404s, not a feature. Keep both false until a backend
# exists again.
NEXT_PUBLIC_ARC_ENABLED=false
NEXT_PUBLIC_ARC_NETWORK=testnet
NEXT_PUBLIC_FEATURE_CCTP_BRIDGE=false

# ── Local-only build switch ──────────────────────────────────────────────
# true → scripting/tabs/<all_urls> become REQUIRED manifest permissions so a
# `Load unpacked` build works. Never ship a dist built with this on.
# POPPIN_TEST_BUILD=true
